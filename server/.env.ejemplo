# Copiar como .env en el servidor. Nunca versionar el .env real.

FLO_PUERTO=3005

# Mismo secreto que los demas modulos de la plataforma: la cookie de sesion
# se emite en cualquier puerta y todos la verifican localmente.
JWT_SECRET=

# Base Plant_Platform de Florence (instancia propia, no la de CSW).
DB_SERVER=
DB_DATABASE=Plant_Platform
DB_USER=
DB_PASSWORD=

# Supuestos por omision. Ver docs/SUPUESTOS.md.
FLO_HORAS=144
FLO_EFICIENCIA=1
FLO_MINUTOS_CAMBIO=45
